# All optional. Without any key, the built-in query planner answers common questions live.
# For everything else, add ONE AI key (only in Vercel's Environment Variables, never in code):
LLM_API_KEY=            # any OpenAI-compatible API, e.g. Groq's free tier (console.groq.com)
LLM_BASE_URL=           # optional, default https://api.groq.com/openai/v1
LLM_MODEL=              # optional, default llama-3.3-70b-versatile
ANTHROPIC_API_KEY=      # or Claude
